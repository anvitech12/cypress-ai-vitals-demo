# Copy to ai.env (gitignored) and fill in. Loaded only in Node (Cypress plugin + Playground server).
# Keys never reach the browser, the Command Log, or the reports.
# Models appear in the app in the order they are written: Cloudflare first, then a few free models to compare.

# ---- Provider keys -------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=   # https://dash.cloudflare.com  (Workers AI: chat, images, voices, transcription)
CLOUDFLARE_API_TOKEN=    # token with "Workers AI: Read" + "Workers AI: Edit"
GROQ_API_KEY=            # https://console.groq.com/keys  (free tier: GPT-OSS 20B, Whisper)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey  (free tier: Gemini Flash-Lite, the judge)
HF_TOKEN=                # optional, free: https://huggingface.co/settings/tokens (raises the Spaces GPU quota)

# ---- Mode ----------------------------------------------------------------------
AI_MODE=live             # live | record | replay
AI_JUDGE=gemini-flash-lite   # grades with a rubric; a different vendor from the models it grades

# Prices are USD list prices, read 2026-10-07 from the Cloudflare model catalog and each provider's pricing page.
# Models tagged "free" run on a free tier. Their cost shows what the same call would cost at list price.

# ======== Chat ========
# Cloudflare Workers AI
AI_MODEL_GPT_OSS_120B=cloudflare:@cf/openai/gpt-oss-120b
AI_MODEL_GPT_OSS_120B_LABEL=GPT-OSS 120B
AI_MODEL_GPT_OSS_120B_PRICE_IN=0.35        # per 1M tokens
AI_MODEL_GPT_OSS_120B_PRICE_OUT=0.75
AI_MODEL_LLAMA_4_SCOUT=cloudflare:@cf/meta/llama-4-scout-17b-16e-instruct
AI_MODEL_LLAMA_4_SCOUT_LABEL=Llama 4 Scout 17B
AI_MODEL_LLAMA_4_SCOUT_PRICE_IN=0.27
AI_MODEL_LLAMA_4_SCOUT_PRICE_OUT=0.85
AI_MODEL_GEMMA_4=cloudflare:@cf/google/gemma-4-26b-a4b-it
AI_MODEL_GEMMA_4_LABEL=Gemma 4 26B
AI_MODEL_GEMMA_4_PRICE_IN=0.10
AI_MODEL_GEMMA_4_PRICE_OUT=0.30
AI_MODEL_MISTRAL_SMALL=cloudflare:@cf/mistralai/mistral-small-3.1-24b-instruct
AI_MODEL_MISTRAL_SMALL_LABEL=Mistral Small 3.1 24B
AI_MODEL_MISTRAL_SMALL_PRICE_IN=0.351
AI_MODEL_MISTRAL_SMALL_PRICE_OUT=0.555
# Free, to compare
AI_MODEL_GPT_OSS_20B=groq:openai/gpt-oss-20b
AI_MODEL_GPT_OSS_20B_LABEL=GPT-OSS 20B (Groq)
AI_MODEL_GPT_OSS_20B_TAGS=free
AI_MODEL_GPT_OSS_20B_PRICE_IN=0.075        # console.groq.com/docs/models
AI_MODEL_GPT_OSS_20B_PRICE_OUT=0.30
AI_MODEL_GEMINI_FLASH_LITE=gemini:gemini-3.5-flash-lite
AI_MODEL_GEMINI_FLASH_LITE_LABEL=Gemini 3.5 Flash-Lite
AI_MODEL_GEMINI_FLASH_LITE_TAGS=free
AI_MODEL_GEMINI_FLASH_LITE_PRICE_IN=0.30   # ai.google.dev/gemini-api/docs/pricing
AI_MODEL_GEMINI_FLASH_LITE_PRICE_OUT=2.50
# Thinking budgets: the same Groq model at three settings (Groq reports thinking tokens)
AI_MODEL_GPT_OSS_20B_LOW=groq:openai/gpt-oss-20b
AI_MODEL_GPT_OSS_20B_LOW_REASONING_EFFORT=low
AI_MODEL_GPT_OSS_20B_LOW_LABEL=GPT-OSS 20B, low thinking
AI_MODEL_GPT_OSS_20B_LOW_TAGS=free
AI_MODEL_GPT_OSS_20B_LOW_PRICE_IN=0.075
AI_MODEL_GPT_OSS_20B_LOW_PRICE_OUT=0.30
AI_MODEL_GPT_OSS_20B_HIGH=groq:openai/gpt-oss-20b
AI_MODEL_GPT_OSS_20B_HIGH_REASONING_EFFORT=high
AI_MODEL_GPT_OSS_20B_HIGH_LABEL=GPT-OSS 20B, high thinking
AI_MODEL_GPT_OSS_20B_HIGH_TAGS=free
AI_MODEL_GPT_OSS_20B_HIGH_PRICE_IN=0.075
AI_MODEL_GPT_OSS_20B_HIGH_PRICE_OUT=0.30
AI_MODEL_GPT_OSS_20B_CAPPED=groq:openai/gpt-oss-20b
AI_MODEL_GPT_OSS_20B_CAPPED_REASONING_EFFORT=high
AI_MODEL_GPT_OSS_20B_CAPPED_MAX_TOKENS=160
AI_MODEL_GPT_OSS_20B_CAPPED_LABEL=GPT-OSS 20B, high thinking, 160-token cap
AI_MODEL_GPT_OSS_20B_CAPPED_TAGS=free
AI_MODEL_GPT_OSS_20B_CAPPED_PRICE_IN=0.075
AI_MODEL_GPT_OSS_20B_CAPPED_PRICE_OUT=0.30

# ======== Images ========
# Cloudflare Workers AI
AI_MODEL_FLUX_SCHNELL=cloudflare:@cf/black-forest-labs/flux-1-schnell
AI_MODEL_FLUX_SCHNELL_LABEL=FLUX.1 schnell
AI_MODEL_FLUX_SCHNELL_PRICE_IMAGE=0.00063  # 1024x1024: 4 tiles + 4 steps
AI_MODEL_PHOENIX=cloudflare:@cf/leonardo/phoenix-1.0
AI_MODEL_PHOENIX_LABEL=Leonardo Phoenix 1.0
AI_MODEL_PHOENIX_PRICE_IMAGE=0.026         # 1024x1024: 4 tiles x $0.00583 + 25 steps x $0.00011
# Free, to compare
AI_MODEL_SDXL_LIGHTNING=cloudflare:@cf/bytedance/stable-diffusion-xl-lightning
AI_MODEL_SDXL_LIGHTNING_LABEL=SDXL Lightning
AI_MODEL_SDXL_LIGHTNING_TAGS=free,beta
AI_MODEL_SDXL_LIGHTNING_PRICE_IMAGE=0      # $0 per step while in beta
AI_MODEL_FLUX_SPACE=hf-space:black-forest-labs/FLUX.1-schnell
AI_MODEL_FLUX_SPACE_LABEL=FLUX.1 schnell (HF Space)
AI_MODEL_FLUX_SPACE_TAGS=free
AI_MODEL_FLUX_SPACE_BODY='{"width":768,"height":768}'
AI_MODEL_FLUX_SPACE_PRICE_IMAGE=0          # free GPU time: 2 min a day without HF_TOKEN, 5 with it

# ======== Voices (text to speech) ========
# Cloudflare Workers AI. The Aura voices are asked for WAV, so the app can add the trailing silence Chrome captions need.
AI_MODEL_AURA_2=cloudflare:@cf/deepgram/aura-2-en
AI_MODEL_AURA_2_LABEL=Deepgram Aura-2
AI_MODEL_AURA_2_BODY='{"encoding":"linear16","container":"wav"}'
AI_MODEL_AURA_2_PRICE_1K_CHARS=0.03
AI_MODEL_AURA_1=cloudflare:@cf/deepgram/aura-1
AI_MODEL_AURA_1_LABEL=Deepgram Aura-1
AI_MODEL_AURA_1_BODY='{"encoding":"linear16","container":"wav"}'
AI_MODEL_AURA_1_PRICE_1K_CHARS=0.015
AI_MODEL_MELOTTS=cloudflare:@cf/myshell-ai/melotts
AI_MODEL_MELOTTS_LABEL=MeloTTS
AI_MODEL_MELOTTS_PRICE_MINUTE=0.000205     # per minute of audio it produces
# Free, to compare (Gemini's free tier allows 10 requests a day)
AI_MODEL_GEMINI_TTS=gemini:gemini-3.8-flash-tts
AI_MODEL_GEMINI_TTS_LABEL=Gemini 3.8 Flash TTS
AI_MODEL_GEMINI_TTS_TAGS=free
AI_MODEL_GEMINI_TTS_PRICE_IN=0.50
AI_MODEL_GEMINI_TTS_PRICE_OUT=9.00

# ======== Listeners (speech to text) ========
# Cloudflare Workers AI
AI_MODEL_WHISPER_CF=cloudflare:@cf/openai/whisper-large-v3-turbo
AI_MODEL_WHISPER_CF_LABEL=Whisper large v3 turbo (Cloudflare)
AI_MODEL_WHISPER_CF_PRICE_MINUTE=0.000513
AI_MODEL_NOVA_3=cloudflare:@cf/deepgram/nova-3
AI_MODEL_NOVA_3_LABEL=Deepgram Nova-3
AI_MODEL_NOVA_3_PRICE_MINUTE=0.0052
# Free, to compare. Chrome's on-device listener is built into the Audio page.
AI_MODEL_WHISPER_TURBO=groq:whisper-large-v3-turbo
AI_MODEL_WHISPER_TURBO_LABEL=Whisper large v3 turbo (Groq)
AI_MODEL_WHISPER_TURBO_TAGS=free
AI_MODEL_WHISPER_TURBO_PRICE_MINUTE=0.000667   # $0.04 per hour of audio

# ---- Bring your own, e.g. a local or self-hosted OpenAI-compatible server ----------
# AI_MODEL_LOCAL=openai-compatible:llama3.2
# AI_MODEL_LOCAL_BASE_URL=http://localhost:11434/v1
# AI_MODEL_LOCAL_API_KEY=ollama
